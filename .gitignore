# See https://help.github.com/articles/ignoring-files/ for more about ignoring files.

# dependencies
/node_modules
/.pnp
.pnp.*
.yarn/*
!.yarn/patches
!.yarn/plugins
!.yarn/releases
!.yarn/versions

# testing
/coverage

# next.js
/.next/
/out/
/.claude/

# AI tooling state (oh-my-claudecode, code-review-graph)
/.omc/
/.code-review-graph/

# production
/build

# misc
.DS_Store
*.pem

# python
__pycache__/
*.pyc
.venv/

# local scratch / test artifacts
/scratch/
/test-upload.js
/test*.jpg

# debug
npm-debug.log*
yarn-debug.log*
yarn-error.log*
.pnpm-debug.log*

# env files (can opt-in for committing if needed)
.env*
!.env.example

# vercel
.vercel

# typescript
*.tsbuildinfo
next-env.d.ts
